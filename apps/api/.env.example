PORT=4000
# Comma-separated origins allowed to make browser requests to this API.
CORS_ORIGINS=http://localhost:3000
# PostgreSQL connection; never commit a real production credential.
DATABASE_URL="postgresql://kobby:change-me@localhost:5432/kobbys_intertech?schema=public"
# Required in production. Use a generated value of at least 32 characters.
JWT_ACCESS_SECRET=replace-this-with-a-long-random-secret-before-production

# Resend Email Notifications
RESEND_API_KEY=re_your_api_key_here
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
EMAIL_FROM="Kobby's Intertech <onboarding@resend.dev>"
WEB_URL=http://localhost:3000
