PORT=4000
# Number of reverse proxies in front of this API. Set to 1 when the API is
# served behind Cloudflare/Render/Nginx so per-visitor rate limiting works;
# leave unset when the API receives client connections directly.
# TRUST_PROXY_HOPS=1
# Comma-separated origins allowed to make browser requests to this API.
CORS_ORIGINS=http://localhost:3000
# PostgreSQL connection; never commit a real production credential.
DATABASE_URL="postgresql://kobby:change-me@localhost:5432/kobbys_intertech?schema=public"
# Required in production. Use a generated value of at least 32 characters.
JWT_ACCESS_SECRET=replace-this-with-a-long-random-secret-before-production

# Resend Email Notifications
RESEND_API_KEY=re_your_api_key_here
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
EMAIL_FROM="Kobby's Intertech <onboarding@resend.dev>"
WEB_URL=http://localhost:3000
# Required once before first production launch. Creates the first Owner only if no account has that email.
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=replace-with-a-unique-8-character-or-longer-password
INITIAL_OWNER_NAME=Account Owner
# Site origin used for staff activation and password-reset links. Do not append `/admin`.
ADMIN_APP_URL=http://localhost:3000

# Cloudflare R2 Object Storage (Photos & Gallery)
# When set, photos are uploaded directly to R2 cloud storage and served via CDN.
# When omitted, photos fall back to local disk storage in development.
CF_R2_ACCOUNT_ID=your_cloudflare_account_id
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CF_R2_BUCKET=kobbys-gallery
CF_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
