generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum ServiceRequestStatus {
  REQUESTED
  UNDER_REVIEW
  AWAITING_CUSTOMER
  SITE_VISIT_REQUIRED
  QUOTATION_PENDING
  AWAITING_ACCEPTANCE
  AWAITING_PAYMENT
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
  DECLINED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CLOSED
  CANCELLED
}

enum RecordVisibility {
  INTERNAL
  CUSTOMER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String
  accountStatus   AccountStatus @default(INVITED)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer?
  roles           UserRole[]
  requestEvents   RequestEvent[]
  quoteEvents     QuoteEvent[]
  appointments    AppointmentAssignment[]
  workOrders      WorkOrderAssignment[]
  workLogs        WorkLog[]
  uploads         Attachment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Customer {
  id                       String            @id @default(uuid()) @db.Uuid
  userId                   String?           @unique @db.Uuid
  fullName                 String
  organisationName         String?
  phone                    String
  email                    String
  preferredContactMethod   String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  user                     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  requests                 ServiceRequest[]
  reviews                  Review[]
  consentRecords           ConsentRecord[]

  @@index([email])
  @@index([phone])
}

model Service {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  slug         String           @unique
  description  String
  formSchema   Json?
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requests     ServiceRequest[]
  projects     Project[]
}

model ServiceRequest {
  id             String               @id @default(uuid()) @db.Uuid
  reference      String               @unique
  idempotencyKey String?              @unique
  customerId     String               @db.Uuid
  serviceId      String               @db.Uuid
  description    String
  address        String
  gpsAddress     String?
  status         ServiceRequestStatus @default(REQUESTED)
  source         String               @default("WEBSITE")
  preferredDate  DateTime?
  timeWindow     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       Customer             @relation(fields: [customerId], references: [id])
  service        Service              @relation(fields: [serviceId], references: [id])
  events         RequestEvent[]
  appointments   Appointment[]
  quotes         Quote[]
  workOrders     WorkOrder[]
  attachments    Attachment[]
  reviews        Review[]

  @@index([customerId, createdAt])
  @@index([serviceId, status])
  @@index([status, updatedAt])
}

model RequestEvent {
  id              String          @id @default(uuid()) @db.Uuid
  requestId       String          @db.Uuid
  actorUserId     String?         @db.Uuid
  eventType       String
  oldStatus       ServiceRequestStatus?
  newStatus       ServiceRequestStatus?
  customerVisible Boolean         @default(false)
  detail          Json?
  createdAt       DateTime        @default(now())
  request         ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUser       User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  requestId         String            @db.Uuid
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(REQUESTED)
  location          String
  rescheduledFromId String?           @unique @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  request           ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rescheduledFrom   Appointment?      @relation("RescheduledAppointments", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment?      @relation("RescheduledAppointments")
  assignments       AppointmentAssignment[]
  workOrders        WorkOrder[]

  @@index([startAt, endAt])
  @@index([requestId, startAt])
}

model AppointmentAssignment {
  appointmentId String      @db.Uuid
  staffUserId   String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  staffUser     User        @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([appointmentId, staffUserId])
  @@index([staffUserId])
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  requestId   String      @db.Uuid
  quoteNumber String      @unique
  version     Int
  status      QuoteStatus @default(DRAFT)
  currency    String      @default("GHS")
  subtotal    Decimal     @db.Decimal(12, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  validUntil  DateTime?
  scope       String?
  exclusions  String?
  paymentTerms String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  items       QuoteItem[]
  events      QuoteEvent[]
  workOrders  WorkOrder[]

  @@unique([requestId, version])
  @@index([requestId, status])
}

model QuoteItem {
  id        String  @id @default(uuid()) @db.Uuid
  quoteId   String  @db.Uuid
  description String
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteEvent {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @db.Uuid
  eventType   String
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
}

model WorkOrder {
  id            String          @id @default(uuid()) @db.Uuid
  requestId     String          @db.Uuid
  appointmentId String?         @db.Uuid
  quoteId       String?         @db.Uuid
  status        WorkOrderStatus @default(DRAFT)
  scope         String
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  request       ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  quote         Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignments   WorkOrderAssignment[]
  logs          WorkLog[]
  attachments   Attachment[]

  @@index([requestId, status])
}

model WorkOrderAssignment {
  workOrderId    String    @db.Uuid
  staffUserId    String    @db.Uuid
  assignmentRole String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  staffUser      User      @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([workOrderId, staffUserId])
  @@index([staffUserId])
}

model WorkLog {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @db.Uuid
  staffUserId String           @db.Uuid
  note        String
  visibility  RecordVisibility @default(INTERNAL)
  loggedAt    DateTime         @default(now())
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  staffUser   User             @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([workOrderId, loggedAt])
}

model Attachment {
  id          String           @id @default(uuid()) @db.Uuid
  requestId   String?          @db.Uuid
  workOrderId String?          @db.Uuid
  storageKey  String           @unique
  mimeType    String
  visibility  RecordVisibility @default(INTERNAL)
  uploadedBy  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  request     ServiceRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([workOrderId])
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String?             @db.Uuid
  channel        NotificationChannel
  templateKey    String
  deliveryStatus DeliveryStatus      @default(PENDING)
  attemptCount   Int                 @default(0)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deliveryStatus, createdAt])
}

model NotificationJob {
  id            String         @id @default(uuid()) @db.Uuid
  eventKey      String         @unique
  payload       Json
  status        DeliveryStatus @default(PENDING)
  nextAttemptAt DateTime?
  createdAt     DateTime       @default(now())
}

model Review {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @db.Uuid
  customerId       String         @db.Uuid
  rating           Int
  comment          String?
  moderationStatus String         @default("PENDING")
  createdAt        DateTime       @default(now())
  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([moderationStatus, createdAt])
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  slug        String       @unique
  serviceId   String?      @db.Uuid
  description String
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  media       ProjectMedia[]
}

model ProjectMedia {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  storageKey   String   @unique
  altText      String
  displayOrder Int      @default(0)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model ConsentRecord {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  purpose       String
  policyVersion String
  recordedAt    DateTime @default(now())
  withdrawnAt   DateTime?
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
}

model GalleryPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @unique
  caption     String?
  takenAt     DateTime?
  uploadedAt  DateTime @default(now())
  sortOrder   Int      @default(0)
}
